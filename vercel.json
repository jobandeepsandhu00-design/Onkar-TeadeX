{
  "buildCommand": "pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/trading-os run build",
  "outputDirectory": "artifacts/trading-os/dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "lib/**"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.mjs?__api_path=$1"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
