MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
# Generate locally, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Placeholder/example values are rejected at startup.
BRIDGE_API_KEY=
# Loopback is the safe default. Only change this behind a firewall plus HTTPS/private tunnel.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
ENABLE_MT5_TRADING=false
ALLOW_LIVE_TRADING=false
MT5_STATE_DB=./mt5_bridge.db
MT5_POLL_SECONDS=1
MT5_HEALTHCHECK_SECONDS=5
MT5_STALE_AFTER_SECONDS=30
MT5_RECONCILE_LOOKBACK_HOURS=72
MT5_RECONCILE_GRACE_SECONDS=30
MT5_PREFLIGHT_GRACE_SECONDS=90
MT5_MAGIC=260919
MT5_LOG_LEVEL=INFO

