# ── Database ────────────────────────────────────────────────
# PostgreSQL connection string
# Railway: copy from your Railway Postgres plugin → Variables → DATABASE_URL
# Neon:    copy from your Neon project dashboard
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Auth ────────────────────────────────────────────────────
# Secret used to sign JWT tokens — use a long random string
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret_string

# ── Server ──────────────────────────────────────────────────
# Port the API server listens on (Railway sets this automatically)
PORT=5000

NODE_ENV=production

# Existing Supabase project configuration used by server-side session checks.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only key required for the scanner API/worker and optional media migration.
# Never expose this key to the browser or add it to the Vite app environment.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Cloudflare R2 (server-side only — never prefix with VITE_) ──────────────
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=onkartradex
CLOUDFLARE_R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
# Optional. Leave blank while lesson media is private and served with signed URLs.
CLOUDFLARE_R2_PUBLIC_URL=

# ── ONKAR AI Market Brain (server + separate worker only) ─────────────────
# The worker is a persistent Node process, NOT a Vercel request handler.
SCANNER_ENABLED=true
ENABLE_LIVE_EXECUTION=false
# Shared secret required by the scheduled scanner endpoint. Generate a long random value.
CRON_SECRET=
# Existing quote/backtest provider credential is reused. No synthetic fallback.
TWELVE_DATA_API_KEY=
# Optional alias for TWELVE_DATA_API_KEY; choose provider per user in scanner UI.
MARKET_DATA_API_KEY=
# Optional exact broker/provider symbol aliases as JSON, e.g. {"NAS100":"NDX"}.
# Verify the instrument matches your intended market; never silently substitute futures.
MARKET_SYMBOL_MAP={}
# Optional Windows MT5 Bridge. The official MetaTrader5 Python package runs on
# that Windows host, never inside this Vercel application.
PRIMARY_MARKET_PROVIDER=twelvedata
MARKET_DATA_FALLBACK_ENABLED=false
MT5_BRIDGE_URL=https://your-private-windows-bridge.example.com
MT5_BRIDGE_API_KEY=replace_with_the_same_32_plus_character_bridge_key
MT5_BRIDGE_USER_ID=replace_with_the_supabase_auth_user_uuid_that_owns_this_terminal
# OpenAI is server-side only. Never prefix these values with VITE_ or NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Supabase URL may be set as SUPABASE_URL in a headless worker instead of VITE_SUPABASE_URL.
SUPABASE_URL=
# Per-user thresholds, account risk and webhook hashes live in Supabase.
# MCP / vision / email / broker execution are extension interfaces, not active integrations.
