# ── Database ────────────────────────────────────────────────
# PostgreSQL connection string
# Railway: copy from your Railway Postgres plugin → Variables → DATABASE_URL
# Neon:    copy from your Neon project dashboard
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Auth ────────────────────────────────────────────────────
# Secret used to sign JWT tokens — use a long random string
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret_string

# ── Server ──────────────────────────────────────────────────
# Port the API server listens on (Railway sets this automatically)
PORT=5000

NODE_ENV=production
