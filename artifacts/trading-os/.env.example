# Public Supabase browser configuration (never use the service_role key here)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Cloudflare R2 credentials belong in the API server/Vercel environment only.
# Never add R2 access keys to this Vite/browser environment file.

